# Public Sanity identifiers; never add private tokens to NEXT_PUBLIC variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=rhtfv6bc
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-01

# Web3Forms Access Key (Get free key from https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Build-time switch. Enable only when building the final production upload.
PUBLIC_INDEXING_ENABLED=false
